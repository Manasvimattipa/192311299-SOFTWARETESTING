package experiments;

public class exp20_vowelconso {
	public static String count(String s) {

        int vowels = 0;
        int consonants = 0;

        try {
            s = s.toLowerCase();

            for (int i = 0; i < s.length(); i++) {
                char ch = s.charAt(i);

                if (ch >= 'a' && ch <= 'z') {
                    if (ch == 'a' || ch == 'e' || ch == 'i'
                            || ch == 'o' || ch == 'u') {
                        vowels++;
                    } else {
                        consonants++;
                    }
                }
            }

            return vowels + "," + consonants;

        } catch (Exception e) {
            return "invalid input";
        }
    }
	

}
